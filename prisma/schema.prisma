generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  ADMIN
}

enum TravelClass {
  ECONOMY
  BUSINESS
  FIRST
}

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  ARRIVED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(PASSENGER)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Station {
  id               String   @id @default(cuid())
  name             String
  city             String
  code             String   @unique
  createdAt        DateTime @default(now())
  originTrips      Trip[]   @relation("OriginStation")
  destinationTrips Trip[]   @relation("DestinationStation")
}

model Train {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Trip {
  id            String     @id @default(cuid())
  trainId       String
  train         Train      @relation(fields: [trainId], references: [id])
  originId      String
  origin        Station    @relation("OriginStation", fields: [originId], references: [id])
  destinationId String
  destination   Station    @relation("DestinationStation", fields: [destinationId], references: [id])
  departsAt     DateTime
  arrivesAt     DateTime
  status        TripStatus @default(SCHEDULED)
  createdAt     DateTime   @default(now())
  fares         Fare[]
  bookings      Booking[]
}

model Fare {
  id             String      @id @default(cuid())
  tripId         String
  trip           Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelClass    TravelClass
  priceKobo      Int
  totalSeats     Int
  remainingSeats Int
  bookings       Booking[]

  @@unique([tripId, travelClass])
}

model Booking {
  id         String        @id @default(cuid())
  reference  String        @unique
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  tripId     String
  trip       Trip          @relation(fields: [tripId], references: [id])
  fareId     String
  fare       Fare          @relation(fields: [fareId], references: [id])
  travelClass TravelClass
  status     BookingStatus @default(PENDING)
  amountKobo Int
  paymentId  String?
  heldUntil  DateTime?
  createdAt  DateTime      @default(now())
  passengers Passenger[]
  tickets    Ticket[]
}

model Passenger {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  ticket    Ticket?
}

model Ticket {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passengerId String    @unique
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  coach       String
  seat        String
  qrPayload   String
}
